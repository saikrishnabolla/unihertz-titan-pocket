--- /dev/null
+++ b/system/gd/hci/titan_controller_compat.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <string_view>
+
+namespace bluetooth::hci {
+// This controller advertises an optional command with an incompatible response.
+inline bool IsTitanPocketLegacyBluetooth(std::string_view device, std::string_view platform,
+                                         std::string_view release) {
+  return device == "Titan_pocket" && platform == "mt6771" &&
+         release == "4.14.186-g40b2a1864-dirty";
+}
+}  // namespace bluetooth::hci
