<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.titanpocket.keyboard" android:versionCode="1" android:versionName="0.1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="37" />
  <application android:label="Titan Pocket keyboard" android:allowBackup="false" android:directBootAware="true" android:hasCode="true">
    <receiver android:name=".KeyboardLayoutReceiver" android:exported="true" android:directBootAware="true">
      <intent-filter>
        <action android:name="android.hardware.input.action.QUERY_KEYBOARD_LAYOUTS" />
      </intent-filter>
      <meta-data android:name="android.hardware.input.metadata.KEYBOARD_LAYOUTS" android:resource="@xml/keyboard_layouts" />
    </receiver>
  </application>
</manifest>
